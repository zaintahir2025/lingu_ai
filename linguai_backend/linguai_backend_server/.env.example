SERVERPOD_RUN_MODE=development

# Change this to a long random value before any shared deployment.
JWT_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Turnstile. This is Cloudflare's official always-pass test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Public URLs used in email and Stripe redirects.
PUBLIC_APP_URL=http://localhost:36537
PUBLIC_API_URL=http://localhost:3000/api/v1

# Temporary QA switch requested by the client. Disable before launch.
TESTING_ADMIN_ACCESS=true

# Transactional email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Stripe subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Built-in premium tutor. BYOK continues to work from Flutter secure storage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
